{
  "id": "sample-kumva-ivr-flow",
  "type": "tab",
  "label": "Sample IVR/SMS Flow",
  "disabled": false,
  "info": "Example flow: trigger -> start -> send -> wait -> send another -> wait -> send another -> wait -> send -> end",
  "nodes": [
    {
      "id": "trigger-1",
      "type": "kumva-trigger",
      "name": "Trigger Contacts",
      "scheduleType": "none",
      "contactSource": "manual",
      "manualContacts": "+254700000001\n+254700000002",
      "phoneColumn": "phone",
      "additionalFields": "name,topic",
      "initialMessage": "Hello ${name}, this is a reminder about ${topic}. Please reply with 1 to confirm or 2 to decline.",
      "rateLimit": 60,
      "wires": [
        ["start-1"]
      ]
    },
    {
      "id": "start-1",
      "type": "kumva-start-campaign",
      "name": "Start Campaign",
      "initiationMode": "outbound",
      "campaignType": "sms",
      "webhookPath": "/kumva/webhook/sample-campaign",
      "sessionTimeout": "1800s",
      "storeResponses": true,
      "debugMode": false,
      "wires": [
        ["send-1"]
      ]
    },
    {
      "id": "send-1",
      "type": "kumva-send-message",
      "name": "Send Welcome SMS",
      "messageType": "sms",
      "messageContent": "Hello ${name}, welcome to our ${topic} campaign. Please reply with 1 to continue.",
      "phoneSource": "msg",
      "retryOnFailure": true,
      "maxRetries": 3,
      "debugMode": false,
      "wires": [
        ["wait-1"]
      ]
    },
    {
      "id": "wait-1",
      "type": "kumva-wait-for-response",
      "name": "Wait for Confirmation",
      "responseTimeout": "60s",
      "handleTimeout": "continue",
      "validateResponse": true,
      "validationRules": "{\"allowedValues\":[\"1\",\"2\"]}",
      "onValidationFail": "continue",
      "storeResponses": true,
      "debugMode": false,
      "wires": [
        ["send-2"],
        ["send-2"],
        ["send-2"]
      ]
    },
    {
      "id": "send-2",
      "type": "kumva-send-message",
      "name": "Send Follow-up SMS",
      "messageType": "sms",
      "messageContent": "Thank you ${name}. We have recorded your choice. We will share more details about ${topic} shortly.",
      "phoneSource": "msg",
      "retryOnFailure": true,
      "maxRetries": 3,
      "debugMode": false,
      "wires": [
        ["wait-2"]
      ]
    },
    {
      "id": "wait-2",
      "type": "kumva-wait-for-response",
      "name": "Wait for Follow-up Reply",
      "responseTimeout": "60s",
      "handleTimeout": "continue",
      "validateResponse": false,
      "storeResponses": true,
      "debugMode": false,
      "wires": [
        ["send-3"],
        ["send-3"],
        ["send-3"]
      ]
    },
    {
      "id": "send-3",
      "type": "kumva-send-message",
      "name": "Send Reminder SMS",
      "messageType": "sms",
      "messageContent": "Reminder for ${topic}: please reply with YES if you want to proceed or NO if you prefer to stop.",
      "phoneSource": "msg",
      "retryOnFailure": true,
      "maxRetries": 3,
      "debugMode": false,
      "wires": [
        ["wait-3"]
      ]
    },
    {
      "id": "wait-3",
      "type": "kumva-wait-for-response",
      "name": "Wait for Final Reply",
      "responseTimeout": "90s",
      "handleTimeout": "continue",
      "validateResponse": false,
      "storeResponses": true,
      "debugMode": false,
      "wires": [
        ["send-4"],
        ["send-4"],
        ["send-4"]
      ]
    },
    {
      "id": "send-4",
      "type": "kumva-send-message",
      "name": "Send Closing SMS",
      "messageType": "sms",
      "messageContent": "Thank you for engaging with the ${topic} campaign. We will close your session now.",
      "phoneSource": "msg",
      "retryOnFailure": true,
      "maxRetries": 3,
      "debugMode": false,
      "wires": [
        ["end-1"]
      ]
    },
    {
      "id": "end-1",
      "type": "kumva-end-flow",
      "name": "End Flow",
      "deleteSession": true,
      "storeReport": true,
      "sendNotification": false,
      "debugMode": false,
      "wires": []
    }
  ]
}
